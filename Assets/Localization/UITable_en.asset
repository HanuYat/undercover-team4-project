  m_TableData:
  - m_Id: 1141968896
    m_Localized: "Too many wrongful arrests! Angry citizens are hunting you \u2014
      if they catch you, you'll be dragged to the plaza."
    m_Metadata:
      m_Items: []
  - m_Id: 6020387639297
    m_Localized: '[Signal Decoder] {0}'
    m_Metadata:
      m_Items:
      - rid: 6276845873749557335
  - m_Id: 21543250890752
    m_Localized: "Carrying \u2014 aim at the HQ revival device and press [E] to place
      (otherwise [E] drops them)"
    m_Metadata:
      m_Items: []
  - m_Id: 21543317999616
    m_Localized: Hold [E] to revive
    m_Metadata:
      m_Items: []
  - m_Id: 21543317999617
    m_Localized: "Out of action \u2014 cannot be revived. Equip the rope and left-click
      to haul them to HQ"
    m_Metadata:
      m_Items: []
  - m_Id: 27357709668352
    m_Localized: "Down \u2014 waiting for a teammate to revive you... ({0}s until
      shutdown)"
    m_Metadata:
      m_Items:
      - rid: 6276845873749557335
  - m_Id: 27357730639872
    m_Localized: "Shut down \u2014 a teammate must haul you to HQ to restore you"
    m_Metadata:
      m_Items: []
  - m_Id: 54069990330368
    m_Localized: "Signal Decoder \u2014 broadcast to everyone"
    m_Metadata:
      m_Items: []
  - m_Id: 54070032273408
    m_Localized: "Enter to send \xB7 Esc to cancel   ({0}/{1})"
    m_Metadata:
      m_Items:
      - rid: 6276845873749557335
