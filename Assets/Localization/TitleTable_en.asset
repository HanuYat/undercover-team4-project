  - m_Id: 10788103327750
    m_Localized: Enter an ID.
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327751
    m_Localized: IDs must be {0}-{1} characters.
    m_Metadata:
      m_Items:
      - rid: 6276845892712267879
  - m_Id: 10788103327752
    m_Localized: IDs can only use letters, digits, and . - @ _
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327753
    m_Localized: Enter a password.
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327754
    m_Localized: Passwords must be {0}-{1} characters.
    m_Metadata:
      m_Items:
      - rid: 6276845892712267879
  - m_Id: 10788103327755
    m_Localized: Passwords can only use letters, digits, and symbols.
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327756
    m_Localized: Passwords need at least one uppercase letter, one lowercase letter,
      one digit, and one symbol.
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327757
    m_Localized: That ID is already taken. Try another one.
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327758
