  - m_Id: 10788103327750
    m_Localized: "\uC544\uC774\uB514\uB97C \uC785\uB825\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327751
    m_Localized: "\uC544\uC774\uB514\uB294 {0}~{1}\uC790\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327752
    m_Localized: "\uC544\uC774\uB514\uC5D0\uB294 \uC601\uBB38\u00B7\uC22B\uC790\uC640 . - @ _ \uB9CC \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327753
    m_Localized: "\uBE44\uBC00\uBC88\uD638\uB97C \uC785\uB825\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327754
    m_Localized: "\uBE44\uBC00\uBC88\uD638\uB294 {0}~{1}\uC790\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327755
    m_Localized: "\uBE44\uBC00\uBC88\uD638\uC5D0\uB294 \uC601\uBB38\u00B7\uC22B\uC790\u00B7\uAE30\uD638\uB9CC \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327756
    m_Localized: "\uBE44\uBC00\uBC88\uD638\uC5D0 \uC601\uBB38 \uB300\u00B7\uC18C\uBB38\uC790, \uC22B\uC790, \uAE30\uD638\uB97C \uAC01\uAC01 1\uC790 \uC774\uC0C1 \uD3EC\uD568\uD574\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327757
    m_Localized: "\uC774\uBBF8 \uC0AC\uC6A9 \uC911\uC778 \uC544\uC774\uB514\uC785\uB2C8\uB2E4. \uB2E4\uB978 \uC544\uC774\uB514\uB97C \uC368 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327758
    m_Localized: "\uC774 \uACC4\uC815\uC5D0\uB294 \uC774\uBBF8 \uC544\uC774\uB514\uAC00 \uC5F0\uB3D9\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327759
    m_Localized: "\uC544\uC774\uB514 \uB610\uB294 \uBE44\uBC00\uBC88\uD638 \uD615\uC2DD\uC774 \uC62C\uBC14\uB974\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327760
    m_Localized: "\uC544\uC774\uB514 \uB610\uB294 \uBE44\uBC00\uBC88\uD638\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694. \uACC4\uC18D \uC2E4\uD328\uD558\uBA74 \uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327761
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uC785\uB825\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327762
    m_Localized: "\uB2C9\uB124\uC784\uC5D0 \uACF5\uBC31\uC744 \uC4F8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327763
    m_Localized: "\uB2C9\uB124\uC784\uC740 {0}\uC790 \uC774\uD558\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327764
    m_Localized: "\uC138\uC158 \uCC38\uAC00 \uC911\uC5D0\uB294 {0} \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327765
    m_Localized: "\uC138\uC158 \uC804\uD658 \uC911\uC5D0\uB294 {0} \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327766
    m_Localized: "\uACC4\uC815\uC744 \uC5F0\uB3D9\uD560"
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327767
    m_Localized: "\uACC4\uC815\uC744 \uBC14\uAFC0"
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327768
    m_Localized: "\uB85C\uADF8\uC778 \uD6C4\uC5D0 \uC5F0\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327769
    m_Localized: "\uC774\uBBF8 \uACC4\uC815\uC774 \uC5F0\uB3D9\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327770
    m_Localized: "\uB85C\uADF8\uC778 \uD6C4\uC5D0 \uACC4\uC815\uC744 \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327771
    m_Localized: "\uCC98\uB9AC \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327772
    m_Localized: "\uACC4\uC815 \uC5F0\uB3D9 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327773
    m_Localized: "\uB85C\uADF8\uC778 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327774
    m_Localized: "\uC0C8 \uC775\uBA85 \uACC4\uC815\uC73C\uB85C \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327775
    m_Localized: "\uD655\uC778\uCC3D\uC744 \uC5F4 \uC218 \uC5C6\uC5B4 \uC5F0\uB3D9\uC744 \uC911\uB2E8\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327776
    m_Localized: "\uD655\uC778\uCC3D\uC744 \uC5F4 \uC218 \uC5C6\uC5B4 \uC804\uD658\uC744 \uC911\uB2E8\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327777
    m_Localized: "ID: {0}"
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327778
    m_Localized: "\uB85C\uADF8\uC778 \uC548 \uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 10788103327779
    m_Localized: "'{0}' \uC544\uC774\uB514\uB85C \uC5F0\uB3D9\uD569\uB2C8\uB2E4.\n\uD55C\uBC88 \uC5F0\uB3D9\uD558\uBA74 \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uACE0, \uC544\uC774\uB514\uB3C4 \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uBE44\uBC00\uBC88\uD638\uB97C \uC78A\uC73C\uBA74 \uACC4\uC815\uC744 \uB418\uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
  - m_Id: 10788103327780
    m_Localized: "\uC774 \uAE30\uAE30\uC5D0\uC11C \uACC4\uC815\uC744 \uBD84\uB9AC\uD558\uACE0 \uC0C8 \uC775\uBA85 \uACC4\uC815\uC73C\uB85C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uACC4\uC815('{0}')\uACFC \uC544\uC774\uB514\uB294 \uC11C\uBC84\uC5D0 \uADF8\uB300\uB85C \uB0A8\uC544 \uB2E4\uC2DC \uB85C\uADF8\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774 \uAE30\uAE30\uC758 \uB2C9\uB124\uC784\uC740 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 6276845892712267880
