  - m_Id: 6994091118601
    m_Localized: "\uACC4\uC815 \uC5F0\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 6994091118602
    m_Localized: "\uACC4\uC815\uC744 \uC5F0\uB3D9\uD558\uBA74 \uB2E4\uB978 \uAE30\uAE30\uC5D0\uC11C\uB3C4
      \uAC19\uC740 \uB2C9\uB124\uC784\uC73C\uB85C \uC811\uC18D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC5F0\uB3D9\uC740
      \uCDE8\uC18C\uD560 \uC218 \uC5C6\uACE0, \uBE44\uBC00\uBC88\uD638\uB97C \uC78A\uC73C\uBA74
      \uACC4\uC815\uC744 \uB418\uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
