  m_TableData:
  - m_Id: 410178883584
    m_Localized: "\uC2A4\uCE90\uB108"
    m_Metadata:
      m_Items: []
  - m_Id: 4509783887872
    m_Localized: "\uC6A9\uC758\uC790\uC758 \uC815\uBCF4\uB97C \uD655\uC778\uD560
      \uB54C \uC0AC\uC6A9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85083466829824
    m_Localized: "\uD14C\uC774\uC800\uAC74"
    m_Metadata:
      m_Items: []
  - m_Id: 85371460325376
    m_Localized: "\uBC1C\uC0AC\uD574\uC11C \uB9DE\uCD94\uBA74 \uC6A9\uC758\uC790\uB97C
      \uC81C\uC555\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 465442687246336
    m_Localized: "\uBC27\uC904"
    m_Metadata:
      m_Items: []
  - m_Id: 465442729189376
    m_Localized: "\uAE30\uC808\uD55C \uB300\uC0C1\uC744 \uBB36\uC5B4 \uC9C8\uC9C8
      \uB04C\uACE0 \uAC08 \uB54C \uC0AC\uC6A9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2627560929300480
    m_Localized: "\uC9C4\uC555\uBD09"
    m_Metadata:
      m_Items: []
  - m_Id: 2627560988020736
    m_Localized: "\uD718\uB458\uB7EC \uADFC\uC811\uD55C \uB300\uC0C1\uC744 \uAC00\uACA9\uD55C\uB2E4.
      \uC5EC\uB7EC \uB300 \uB9DE\uD788\uBA74 \uAE30\uC808\uC2DC\uD0AC \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5508625448636416
    m_Localized: "\uC2E0\uD638 \uD574\uC11D\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 5508625507356672
    m_Localized: "\uBCF8\uBD80\uC5D0 \uC124\uCE58\uB418\uB294 \uB2E8\uB9D0. \uC9E7\uC740
      \uBA54\uC2DC\uC9C0\uB97C \uD300 \uC804\uC6D0\uC5D0\uAC8C \uBCF4\uB0B8\uB2E4.
      \uC804\uC790\uAE30\uAE30 \uBA39\uD1B5 \uC911\uC5D0\uB3C4 \uB610\uB837\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5508625507356673
    m_Localized: "\uACBD\uBCF4 \uBC84\uD2BC"
    m_Metadata:
      m_Items: []
  - m_Id: 5508625507356674
    m_Localized: "\uBCF8\uBD80\uC5D0 \uC124\uCE58\uB418\uB294 \uACBD\uBCF4 \uBC84\uD2BC.\n\uC0AC\uC774\uB80C\uC744
      \uC6B8\uB824 \uD0C8\uC625\uC744 \uC800\uC9C0\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5508625507356675
    m_Localized: "\uBD80\uD65C \uD0A4\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 5508625507356676
    m_Localized: "\uAE30\uB2A5 \uC815\uC9C0\uB41C \uB3D9\uB8CC\uB97C \uADF8 \uC790\uB9AC\uC5D0\uC11C
      \uC989\uC2DC \uC77C\uC73C\uD0A8\uB2E4. \uD55C \uBC88 \uC4F0\uBA74 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12729268256169984
    m_Localized: "\uD790\uD329"
    m_Metadata:
      m_Items: []
  - m_Id: 12729386766229504
    m_Localized: "\uC790\uC2E0\uC758 \uCCB4\uB825\uC744 \uC77C\uC815\uB7C9 \uD68C\uBCF5\uC2DC\uD0A8\uB2E4."
  - m_Id: 12488576126152704
    m_Localized: "\uAD6C\uC5ED \uC2A4\uCE94"
    m_Metadata:
      m_Items: []
  - m_Id: 12488576134541312
    m_Localized: "\uBC18\uACBD 20m \uC548\uC5D0 \uC9C4\uBC94\uC774 \uC788\uC73C\uBA74
      \uCD08\uB85D, \uC5C6\uC73C\uBA74 \uBE68\uAC15\uC73C\uB85C \uB9C1\uC744 \uB744\uC6B4\uB2E4.
      \uCFE8\uD0C0\uC784 60\uCD08."
    m_Metadata:
      m_Items: []
  - m_Id: 816000000000001
    m_Localized: "\uAC70\uB300 \uBFC5\uB9DD\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 816000000000002
    m_Localized: "\uD3C9\uC18C\uC5D4 \uCCB4\uB825\uC744 \uC0B4\uC9DD\uB9CC \uAE4E\uC9C0\uB9CC, \uC544\uC8FC \uB0AE\uC740 \uD655\uB960\uB85C \uB300\uC0C1\uC744 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC644\uC804\uD788 \uBB34\uB825\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
