  - m_Id: 3135767646208
    m_Localized: Hold [E] to revive
    m_Metadata:
      m_Items: []
  - m_Id: 3135780229120
    m_Localized: "Down \u2014 waiting for a teammate to revive you... ({0}s until
      shutdown)"
    m_Metadata:
      m_Items:
      - rid: 6276845892712267875
  - m_Id: 3135780229121
    m_Localized: "Carrying \u2014 aim at the HQ revival device and press [E] to place
      (otherwise [E] drops them)"
    m_Metadata:
      m_Items: []
  - m_Id: 3135780229122
    m_Localized: "Out of action \u2014 cannot be revived. Equip the rope and left-click
      to haul them to HQ"
    m_Metadata:
      m_Items: []
  - m_Id: 3135784423424
    m_Localized: "Shut down \u2014 a teammate must haul you to HQ to restore you"
    m_Metadata:
      m_Items: []
  - m_Id: 3135784423425
    m_Localized: "Too many wrongful arrests! Angry citizens are hunting you \u2014
      if they catch you, you'll be dragged to the plaza."
